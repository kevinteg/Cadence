// src/write/edits.ts
import path18 from "node:path";
import { readdir, readFile as readFile10 } from "node:fs/promises";
import { existsSync as existsSync11 } from "node:fs";

// src/write/checklist.ts
var ITEM_RE2 = /^(\s*-\s+\[)([ xX])(\]\s+)(.+?)(\s*)$/;
function toggleChecklistItem(body, sectionName, match, checked) {
  const result = mutateInSection(body, sectionName, (line, itemIndex, item) => {
    if (item === void 0) return null;
    const isMatch = typeof match === "number" ? itemIndex === match : item.text.toLowerCase().includes(match.toLowerCase());
    if (!isMatch) return null;
    const re = ITEM_RE2.exec(line);
    if (!re) return null;
    const [, lead, , close, rest, trail] = re;
    return {
      newLine: `${lead}${checked ? "x" : " "}${close}${rest}${trail}`,
      matchedText: item.text
    };
  });
  if (!result) {
    throw new Error(
      `no checklist item matched "${match}" in section "${sectionName}"`
    );
  }
  return result;
}
function appendChecklistItem(body, sectionName, text, checked = false) {
  const sectionRe = headerRegex(sectionName);
  const lines = body.split("\n");
  const startIdx = lines.findIndex((l) => sectionRe.test(l));
  if (startIdx < 0) {
    const trailing = lines[lines.length - 1] === "" ? "" : "\n";
    return body.replace(/\n+$/, "") + `

## ${capitalize(sectionName)}
- [${checked ? "x" : " "}] ${text}` + trailing;
  }
  let endIdx = lines.length;
  for (let i = startIdx + 1; i < lines.length; i++) {
    if (/^##\s+/.test(lines[i] ?? "")) {
      endIdx = i;
      break;
    }
  }
  while (endIdx > startIdx + 1 && (lines[endIdx - 1] ?? "").trim() === "") {
    endIdx--;
  }
  const before = lines.slice(0, endIdx);
  const after = lines.slice(endIdx);
  before.push(`- [${checked ? "x" : " "}] ${text}`);
  return [...before, ...after].join("\n");
}
function mutateInSection(body, sectionName, fn) {
  const sectionRe = headerRegex(sectionName);
  const lines = body.split("\n");
  let inSection = false;
  let itemIndex = 0;
  let result = null;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i] ?? "";
    if (sectionRe.test(line)) {
      inSection = true;
      itemIndex = 0;
      continue;
    }
    if (inSection && /^##\s+/.test(line)) {
      inSection = false;
    }
    if (!inSection) continue;
    const re = ITEM_RE2.exec(line);
    if (!re) continue;
    const text = re[4] ?? "";
    const checked = (re[2] ?? " ").toLowerCase() === "x";
    const out = fn(line, itemIndex, { text, checked });
    itemIndex++;
    if (out) {
      lines[i] = out.newLine;
      result = { body: lines.join("\n"), matched: out.matchedText };
      return result;
    }
  }
  return result;
}
function headerRegex(sectionName) {
  const escaped = sectionName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(`^##\\s+${escaped}\\s*$`, "i");
}
function capitalize(s) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
function appendParagraphToSection(body, sectionName, text) {
  const sectionRe = headerRegex(sectionName);
  const lines = body.split("\n");
  const startIdx = lines.findIndex((l) => sectionRe.test(l));
  if (startIdx < 0) {
    const trailing = body.endsWith("\n") ? "" : "\n";
    return body.replace(/\n+$/, "") + `

## ${capitalize(sectionName)}

${text}` + trailing;
  }
  let endIdx = lines.length;
  for (let i = startIdx + 1; i < lines.length; i++) {
    if (/^##\s+/.test(lines[i] ?? "")) {
      endIdx = i;
      break;
    }
  }
  while (endIdx > startIdx + 1 && (lines[endIdx - 1] ?? "").trim() === "") {
    endIdx--;
  }
  const before = lines.slice(0, endIdx);
  const after = lines.slice(endIdx);
  if (endIdx > startIdx + 1 && (before[before.length - 1] ?? "").trim() !== "") {
    before.push("");
  }
  before.push(text);
  return [...before, ...after].join("\n");
}
function computeProjectProgress(body) {
  return {
    dodProgress: progressFor(body, "Definition of Done"),
    actionProgress: progressFor(body, "Actions")
  };
}
function progressFor(body, sectionName) {
  const sectionRe = headerRegex(sectionName);
  const lines = body.split("\n");
  let inSection = false;
  let total = 0;
  let done = 0;
  for (const line of lines) {
    if (sectionRe.test(line)) {
      inSection = true;
      continue;
    }
    if (inSection && /^##\s+/.test(line)) inSection = false;
    if (!inSection) continue;
    const m = ITEM_RE2.exec(line);
    if (!m) continue;
    total++;
    if ((m[2] ?? " ").toLowerCase() === "x") done++;
  }
  return { done, total };
}

// src/write/origin-sync.ts
import { execFile as execFile3 } from "node:child_process";
import { promisify as promisify3 } from "node:util";
var execFileP3 = promisify3(execFile3);
async function syncOrigin(origin, outcome, context) {
  if (!origin) return { kind: "no_origin" };
  if (origin.kind !== "github_issue") return { kind: "no_origin" };
  const { repo, number: number4, url: url2 } = origin;
  if (outcome.kind === "started") {
    return syncStarted(repo, number4, url2, context);
  }
  return syncClosed(repo, number4, url2, outcome, context);
}
async function syncClosed(repo, number4, url2, outcome, context) {
  const state = await ghIssueState(repo, number4);
  if (state === "gh_unavailable") return { kind: "gh_unavailable" };
  if (state === "error") {
    return { kind: "error", message: "gh issue view failed" };
  }
  if (state === "CLOSED") {
    return { kind: "already_closed", issue_number: number4, repo, url: url2 };
  }
  const tag = `project \`${context.pursuitId}/${context.projectId}\``;
  const comment = outcome.kind === "done" ? `Closed by Cadence \u2014 ${tag} resolved as done.` : `Closed by Cadence \u2014 ${tag} was dropped. Reason: ${outcome.reason}`;
  try {
    await execFileP3(
      "gh",
      ["issue", "close", String(number4), "--repo", repo, "--comment", comment],
      { timeout: 8e3 }
    );
    return { kind: "closed", issue_number: number4, repo, url: url2 };
  } catch (err) {
    return {
      kind: "error",
      message: err instanceof Error ? err.message : String(err)
    };
  }
}
async function syncStarted(repo, number4, url2, context) {
  const meta = await ghIssueMeta(repo, number4);
  if (meta === "gh_unavailable") return { kind: "gh_unavailable" };
  if (meta === "error") {
    return { kind: "error", message: "gh issue view failed" };
  }
  const hasInProgress = meta.labels.includes("in-progress");
  if (hasInProgress) {
    return { kind: "already_started", issue_number: number4, repo, url: url2 };
  }
  const tag = `project \`${context.pursuitId}/${context.projectId}\``;
  const comment = `Work started by Cadence on ${tag}.`;
  try {
    const labelArgs = ["--add-label", "in-progress"];
    if (meta.labels.includes("triaged-routed")) {
      labelArgs.push("--remove-label", "triaged-routed");
    }
    await execFileP3(
      "gh",
      ["issue", "edit", String(number4), "--repo", repo, ...labelArgs],
      { timeout: 8e3 }
    );
    await execFileP3(
      "gh",
      ["issue", "comment", String(number4), "--repo", repo, "--body", comment],
      { timeout: 8e3 }
    );
    return { kind: "started", issue_number: number4, repo, url: url2 };
  } catch (err) {
    return {
      kind: "error",
      message: err instanceof Error ? err.message : String(err)
    };
  }
}
async function ghIssueState(repo, number4) {
  try {
    const { stdout } = await execFileP3(
      "gh",
      ["issue", "view", String(number4), "--repo", repo, "--json", "state"],
      { timeout: 5e3 }
    );
    const parsed = JSON.parse(stdout);
    if (parsed.state === "OPEN" || parsed.state === "CLOSED") return parsed.state;
    return "error";
  } catch (err) {
    if (isGhMissing(err)) return "gh_unavailable";
    return "error";
  }
}
async function ghIssueMeta(repo, number4) {
  try {
    const { stdout } = await execFileP3(
      "gh",
      [
        "issue",
        "view",
        String(number4),
        "--repo",
        repo,
        "--json",
        "state,labels"
      ],
      { timeout: 5e3 }
    );
    const parsed = JSON.parse(stdout);
    if (parsed.state !== "OPEN" && parsed.state !== "CLOSED") return "error";
    const labels = (parsed.labels ?? []).map((l) => l.name).filter((n) => typeof n === "string");
    return { state: parsed.state, labels };
  } catch (err) {
    if (isGhMissing(err)) return "gh_unavailable";
    return "error";
  }
}
function isGhMissing(err) {
  const msg = err instanceof Error ? err.message : String(err);
  return /ENOENT|not found.*gh|command not found/i.test(msg);
}

// src/write/edits.ts
async function setProjectStatus(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.id, opts.pursuit);
  const now = opts.now ?? /* @__PURE__ */ new Date();
  let previousStatus;
  let origin;
  let pursuitId;
  await mutateFrontmatter(filePath, (data, body) => {
    previousStatus = typeof data["status"] === "string" ? data["status"] : void 0;
    pursuitId = typeof data["pursuit"] === "string" ? data["pursuit"] : void 0;
    const parsedOrigin = OriginSchema.safeParse(data["origin"]);
    if (parsedOrigin.success) origin = parsedOrigin.data;
    data["status"] = opts.status;
    if (opts.status === "dropped") {
      if (!opts.reason) {
        throw new Error("dropping a project requires a reason");
      }
      data["dropped_reason"] = opts.reason;
      data["dropped_at"] = isoTimestamp(now);
    }
    return { data, body };
  });
  const result = {
    path: path18.relative(repoRoot, filePath)
  };
  if (opts.include_pursuit) {
    result.pursuit = await summarizePursuit(repoRoot, filePath);
  }
  if (origin && pursuitId && previousStatus !== opts.status) {
    if (opts.status === "done" || opts.status === "dropped") {
      const outcome = opts.status === "dropped" ? { kind: "dropped", reason: opts.reason ?? "" } : { kind: "done" };
      result.origin_sync = await syncOrigin(origin, outcome, {
        projectId: opts.id,
        pursuitId
      });
    } else if (opts.status === "active") {
      result.origin_sync = await syncOrigin(
        origin,
        { kind: "started" },
        { projectId: opts.id, pursuitId }
      );
    }
  }
  return result;
}
async function syncProjectOrigin(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.id, opts.pursuit);
  const { data } = await loadFrontmatterFile(filePath);
  const status = typeof data["status"] === "string" ? data["status"] : void 0;
  const pursuitId = typeof data["pursuit"] === "string" ? data["pursuit"] : void 0;
  if (status !== "done" && status !== "dropped" && status !== "active") {
    throw new Error(
      `sync-origin only runs on active or resolved projects (status active|done|dropped); ${opts.id} is currently ${status ?? "unknown"}`
    );
  }
  if (!pursuitId) {
    throw new Error(`project ${opts.id} is missing a pursuit field`);
  }
  const parsedOrigin = OriginSchema.safeParse(data["origin"]);
  if (!parsedOrigin.success) {
    return {
      path: path18.relative(repoRoot, filePath),
      origin_sync: { kind: "no_origin" }
    };
  }
  let outcome;
  if (status === "dropped") {
    outcome = { kind: "dropped", reason: String(data["dropped_reason"] ?? "") };
  } else if (status === "done") {
    outcome = { kind: "done" };
  } else {
    outcome = { kind: "started" };
  }
  const origin_sync = await syncOrigin(parsedOrigin.data, outcome, {
    projectId: opts.id,
    pursuitId
  });
  return { path: path18.relative(repoRoot, filePath), origin_sync };
}
async function summarizePursuit(repoRoot, projectFilePath) {
  const projectsDir = path18.dirname(projectFilePath);
  const pursuitDir = path18.dirname(projectsDir);
  const pursuitId = path18.basename(pursuitDir);
  const projects = [];
  if (existsSync11(projectsDir)) {
    for (const entry of await readdir(projectsDir, { withFileTypes: true })) {
      if (!entry.isFile() || !entry.name.endsWith(".md")) continue;
      const file = path18.join(projectsDir, entry.name);
      const text = await readFile10(file, "utf8");
      const { data } = parseFrontmatter(text);
      const id = String(data["id"] ?? entry.name.replace(/\.md$/, ""));
      const status = String(data["status"] ?? "active");
      projects.push({ id, status });
    }
  }
  const done = projects.filter(
    (p) => p.status === "done" || p.status === "dropped"
  ).length;
  const total = projects.length;
  return {
    id: pursuitId,
    projects,
    done,
    total,
    allResolved: total > 0 && done === total
  };
}
async function setIdeaState(repoRoot, opts) {
  const filePath = await locateIdea(repoRoot, opts.id, opts.parent);
  const now = opts.now ?? /* @__PURE__ */ new Date();
  await mutateFrontmatter(filePath, (data, body) => {
    data["state"] = opts.state;
    if (opts.state === "developed") {
      if (!data["developed_at"]) data["developed_at"] = dateString(now);
    } else if (opts.state === "promoted") {
      if (!opts.promoted_to) {
        throw new Error("promoting an idea requires --promoted-to");
      }
      data["promoted_to"] = opts.promoted_to;
    } else if (opts.state === "closed") {
      if (!opts.reason) {
        throw new Error("closing an idea requires a reason");
      }
      data["closed_reason"] = opts.reason;
    } else if (opts.state === "moved") {
      if (opts.new_parent) data["parent"] = opts.new_parent;
    }
    return { data, body };
  });
  return { path: path18.relative(repoRoot, filePath) };
}
async function checkItem(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  const checked = opts.checked ?? true;
  const sectionName = opts.section === "dod" ? "Definition of Done" : "Actions";
  let matched = "";
  let promoted = false;
  let finalBody = "";
  let origin;
  let pursuitId;
  await mutateFrontmatter(filePath, (data, body) => {
    const result2 = toggleChecklistItem(body, sectionName, opts.match, checked);
    matched = result2.matched;
    let nextBody = result2.body;
    if (opts.note && checked) {
      nextBody = appendNote(nextBody, sectionName, matched, opts.note);
    }
    if (opts.section === "action" && checked && data["status"] === "on_hold") {
      data["status"] = "active";
      promoted = true;
      pursuitId = typeof data["pursuit"] === "string" ? data["pursuit"] : void 0;
      const parsedOrigin = OriginSchema.safeParse(data["origin"]);
      if (parsedOrigin.success) origin = parsedOrigin.data;
    }
    finalBody = nextBody;
    return { data, body: nextBody };
  });
  const progress2 = computeProjectProgress(finalBody);
  const result = {
    path: path18.relative(repoRoot, filePath),
    matched,
    ...promoted ? { promoted: true } : {},
    ...progress2
  };
  if (promoted && origin && pursuitId) {
    result.origin_sync = await syncOrigin(
      origin,
      { kind: "started" },
      { projectId: opts.project, pursuitId }
    );
  }
  return result;
}
async function checkItems(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  const checked = opts.checked ?? true;
  const sectionName = opts.section === "dod" ? "Definition of Done" : "Actions";
  const matched = [];
  let promoted = false;
  let finalBody = "";
  let origin;
  let pursuitId;
  await mutateFrontmatter(filePath, (data, body) => {
    let nextBody = body;
    for (const match of opts.matches) {
      const result2 = toggleChecklistItem(nextBody, sectionName, match, checked);
      matched.push(result2.matched);
      nextBody = result2.body;
    }
    if (opts.section === "action" && checked && data["status"] === "on_hold" && opts.matches.length > 0) {
      data["status"] = "active";
      promoted = true;
      pursuitId = typeof data["pursuit"] === "string" ? data["pursuit"] : void 0;
      const parsedOrigin = OriginSchema.safeParse(data["origin"]);
      if (parsedOrigin.success) origin = parsedOrigin.data;
    }
    finalBody = nextBody;
    return { data, body: nextBody };
  });
  const progress2 = computeProjectProgress(finalBody);
  const result = {
    path: path18.relative(repoRoot, filePath),
    matched,
    ...promoted ? { promoted: true } : {},
    ...progress2
  };
  if (promoted && origin && pursuitId) {
    result.origin_sync = await syncOrigin(
      origin,
      { kind: "started" },
      { projectId: opts.project, pursuitId }
    );
  }
  return result;
}
async function addItem(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  const sectionName = opts.section === "dod" ? "Definition of Done" : opts.section === "action" ? "Actions" : "Notes";
  let finalBody = "";
  await mutateFrontmatter(filePath, (data, body) => {
    const nextBody = opts.section === "notes" ? appendParagraphToSection(body, sectionName, opts.text) : appendChecklistItem(body, sectionName, opts.text, opts.checked ?? false);
    finalBody = nextBody;
    return { data, body: nextBody };
  });
  const progress2 = computeProjectProgress(finalBody);
  return {
    path: path18.relative(repoRoot, filePath),
    ...progress2
  };
}
async function addItems(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  const sectionName = opts.section === "dod" ? "Definition of Done" : opts.section === "action" ? "Actions" : "Notes";
  let finalBody = "";
  await mutateFrontmatter(filePath, (data, body) => {
    let nextBody = body;
    for (const text of opts.texts) {
      nextBody = opts.section === "notes" ? appendParagraphToSection(nextBody, sectionName, text) : appendChecklistItem(
        nextBody,
        sectionName,
        text,
        opts.checked ?? false
      );
    }
    finalBody = nextBody;
    return { data, body: nextBody };
  });
  const progress2 = computeProjectProgress(finalBody);
  return {
    path: path18.relative(repoRoot, filePath),
    added: opts.texts.length,
    ...progress2
  };
}
async function addWaitingFor(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  await mutateFrontmatter(filePath, (data, body) => {
    const list = Array.isArray(data["waiting_for"]) ? [...data["waiting_for"]] : [];
    list.push({
      person: opts.person,
      what: opts.what,
      expected: opts.expected,
      flagged: false
    });
    data["waiting_for"] = list;
    return { data, body };
  });
  return { path: path18.relative(repoRoot, filePath) };
}
async function flagWaitingFor(repoRoot, opts) {
  const filePath = await locateProject(repoRoot, opts.project, opts.pursuit);
  const flagged = opts.flagged ?? true;
  let matched = { person: "", what: "" };
  await mutateFrontmatter(filePath, (data, body) => {
    const list = Array.isArray(data["waiting_for"]) ? [...data["waiting_for"]] : [];
    let foundIndex = -1;
    if (typeof opts.match === "number") {
      foundIndex = opts.match;
    } else {
      const lower = opts.match.toLowerCase();
      foundIndex = list.findIndex((w) => {
        const person = String(w["person"] ?? "").toLowerCase();
        const what = String(w["what"] ?? "").toLowerCase();
        return person.includes(lower) || what.includes(lower);
      });
    }
    if (foundIndex < 0 || foundIndex >= list.length) {
      throw new Error(`no waiting_for matched "${opts.match}"`);
    }
    const item = list[foundIndex] ?? {};
    item["flagged"] = flagged;
    list[foundIndex] = item;
    matched = {
      person: String(item["person"] ?? ""),
      what: String(item["what"] ?? "")
    };
    data["waiting_for"] = list;
    return { data, body };
  });
  return { path: path18.relative(repoRoot, filePath), matched };
}
async function locateProject(repoRoot, projectId, pursuitHint) {
  if (pursuitHint) {
    const file = resolveProjectFile(repoRoot, pursuitHint, projectId);
    if (!file) {
      throw new Error(`project not found: ${pursuitHint}/${projectId}`);
    }
    return file;
  }
  const roots = ["pursuits", "pursuits/_someday", "pursuits/_archived"];
  for (const root of roots) {
    const absRoot = path18.join(repoRoot, root);
    if (!existsSync11(absRoot)) continue;
    for (const pursuit of await readdir(absRoot, { withFileTypes: true })) {
      if (!pursuit.isDirectory()) continue;
      const candidate = path18.join(
        absRoot,
        pursuit.name,
        "projects",
        `${projectId}.md`
      );
      if (existsSync11(candidate)) return candidate;
    }
  }
  throw new Error(
    `project not found: ${projectId} (pass --pursuit to disambiguate)`
  );
}
async function locateIdea(repoRoot, ideaId, parentHint) {
  if (parentHint) {
    const file = resolveIdeaFile(repoRoot, parentHint, ideaId);
    if (!file) throw new Error(`idea not found: ${parentHint}/${ideaId}`);
    return file;
  }
  const roots = ["pursuits", "pursuits/_someday", "pursuits/_archived"];
  for (const root of roots) {
    const absRoot = path18.join(repoRoot, root);
    if (!existsSync11(absRoot)) continue;
    for (const pursuit of await readdir(absRoot, { withFileTypes: true })) {
      if (!pursuit.isDirectory()) continue;
      const candidate = path18.join(
        absRoot,
        pursuit.name,
        "ideas",
        `${ideaId}.md`
      );
      if (existsSync11(candidate)) return candidate;
    }
  }
  throw new Error(
    `idea not found: ${ideaId} (pass --parent to disambiguate)`
  );
}
function appendNote(body, sectionName, itemText, note) {
  const lines = body.split("\n");
  const sectionRe = new RegExp(`^##\\s+${escapeRe(sectionName)}\\s*$`, "i");
  let inSection = false;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i] ?? "";
    if (sectionRe.test(line)) {
      inSection = true;
      continue;
    }
    if (inSection && /^##\s+/.test(line)) inSection = false;
    if (!inSection) continue;
    if (line.includes(itemText)) {
      const indent = (/^(\s*)/.exec(line)?.[1] ?? "") + "  ";
      lines.splice(i + 1, 0, `${indent}- ${note}`);
      return lines.join("\n");
    }
  }
  return body;
}
function escapeRe(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// src/write/move.ts
import path19 from "node:path";
import { existsSync as existsSync12 } from "node:fs";
async function movePursuit(repoRoot, opts) {
  const from = resolvePursuitDir(repoRoot, opts.id);
  if (!from) throw new Error(`pursuit not found: ${opts.id}`);
  const targetParent = opts.to === "active" ? path19.join(repoRoot, "pursuits") : opts.to === "someday" ? path19.join(repoRoot, "pursuits/_someday") : opts.to === "dropped" ? path19.join(repoRoot, "pursuits/_dropped") : path19.join(repoRoot, "pursuits/_archived");
  const to = path19.join(targetParent, opts.id);
  if (path19.resolve(from) === path19.resolve(to)) {
    return {
      from: path19.relative(repoRoot, from),
      to: path19.relative(repoRoot, to)
    };
  }
  if (existsSync12(to)) {
    throw new Error(`destination already exists: ${path19.relative(repoRoot, to)}`);
  }
  await moveDir(from, to);
  await mutateFrontmatter(path19.join(to, "pursuit.md"), (data, body) => {
    data["status"] = opts.to;
    return { data, body };
  });
  return {
    from: path19.relative(repoRoot, from),
    to: path19.relative(repoRoot, to)
  };
}

