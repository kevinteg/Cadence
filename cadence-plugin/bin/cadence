      case STYLE_DOUBLE:
        return '"' + escapeString(string4) + '"';
      default:
        throw new exception("impossible error: invalid scalar style");
    }
  }();
}
function blockHeader(string4, indentPerLevel) {
  var indentIndicator = needIndentIndicator(string4) ? String(indentPerLevel) : "";
