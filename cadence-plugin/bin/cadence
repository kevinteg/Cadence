function uniqueCapturePath(dir, slug) {
  let candidate = path16.join(dir, `${slug}.md`);
  let n = 2;
  while (existsSync9(candidate)) {
    candidate = path16.join(dir, `${slug}-${n}.md`);
    n += 1;
  }
  return candidate;
}

