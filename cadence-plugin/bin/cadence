async function discoverMcpServers(repoRoot, opts = {}) {
  const homeDir = opts.homeDir ?? os.homedir();
  const userServers = await readClaudeUserServers(homeDir);
  const projectServers = await readProjectMcpServers(repoRoot);
  return [...userServers, ...projectServers];
}
function mergeMcpRegistry(cadenceYamlServers, discovered) {
  const merged = /* @__PURE__ */ new Map();
  for (const s of discovered) {
    merged.set(s.name, s);
  }
  for (const s of cadenceYamlServers) {
    merged.set(s.name, { ...s, source: "cadence-yaml" });
  }
  const servers = [];
  const sources = /* @__PURE__ */ new Map();
  for (const [name, entry] of merged) {
    const { source: _ignored, ...rest } = entry;
    servers.push(rest);
    sources.set(name, entry.source);
  }
  return { servers, sources };
}
async function readClaudeUserServers(homeDir) {
  const candidate = path.join(homeDir, ".claude.json");
  if (!existsSync(candidate)) return [];
  return parseMcpServersFile(candidate, "claude-user");
}
async function readProjectMcpServers(repoRoot) {
  const candidate = path.join(repoRoot, ".mcp.json");
  if (!existsSync(candidate)) return [];
  return parseMcpServersFile(candidate, "mcp-project");
}
async function parseMcpServersFile(filePath, source) {
  let raw;
  try {
    raw = await readFile(filePath, "utf8");
  } catch {
    return [];
  }
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return [];
  }
  const root = parsed;
  const entries = root["mcpServers"];
  if (!entries || typeof entries !== "object") return [];
  const out = [];
  for (const [name, val] of Object.entries(entries)) {
    const cfg = coerceEntry(name, val, source);
    if (cfg) out.push(cfg);
  }
  return out;
}
function coerceEntry(name, raw, source) {
  if (!raw || typeof raw !== "object") return null;
  const entry = raw;
  const declaredType = typeof entry["type"] === "string" ? entry["type"] : void 0;
  const declaredTransport = typeof entry["transport"] === "string" ? entry["transport"] : void 0;
  const kindHint = declaredType ?? declaredTransport;
  const url2 = typeof entry["url"] === "string" ? entry["url"] : void 0;
  const command = typeof entry["command"] === "string" ? entry["command"] : void 0;
  const isHttp = kindHint === "http" || kindHint === "https" || kindHint === "sse" || kindHint === "streamable-http" || kindHint === void 0 && url2 !== void 0;
  const isStdio = kindHint === "stdio" || kindHint === void 0 && command !== void 0;
  if (isHttp && url2) {
    return {
      kind: "http",
      name,
      url: url2,
      headers: coerceStringMap(entry["headers"]) ?? {},
      timeoutMs: typeof entry["timeout_ms"] === "number" ? entry["timeout_ms"] : MCP_DEFAULT_TIMEOUT_MS,
      source
    };
  }
  if (isStdio && command) {
    const args = Array.isArray(entry["args"]) ? entry["args"].filter(
      (a) => typeof a === "string"
    ) : [];
    return {
      kind: "stdio",
      name,
      command,
      args,
      env: coerceStringMap(entry["env"]) ?? {},
      ...typeof entry["cwd"] === "string" ? { cwd: entry["cwd"] } : {},
      timeoutMs: typeof entry["timeout_ms"] === "number" ? entry["timeout_ms"] : MCP_DEFAULT_TIMEOUT_MS,
      source
    };
  }
  return null;
}
function coerceStringMap(v) {
  if (!v || typeof v !== "object") return void 0;
  const out = {};
  for (const [k, val] of Object.entries(v)) {
    if (typeof val === "string") out[k] = val;
  }
  return out;
}

// src/config.ts
async function loadConfig(repoRoot) {
  const configPath = path2.join(repoRoot, "cadence.yaml");
  let raw = ConfigSchema.parse({});
  try {
    const text = await readFile2(configPath, "utf8");
    const parsed = jsYaml.load(text, { schema: jsYaml.CORE_SCHEMA }) ?? {};
    raw = ConfigSchema.parse(parsed);
  } catch (err) {
    if (err.code !== "ENOENT") throw err;
  }
  const cfg = mergeDefaults(raw, process.env);
  const discovered = await discoverMcpServers(repoRoot);
  const { servers } = mergeMcpRegistry(cfg.mcp_servers, discovered);
  return { ...cfg, mcp_servers: servers };
}
async function loadCadenceYamlMcpServers(repoRoot) {
  const configPath = path2.join(repoRoot, "cadence.yaml");
  let raw = ConfigSchema.parse({});
  try {
    const text = await readFile2(configPath, "utf8");
    const parsed = jsYaml.load(text, { schema: jsYaml.CORE_SCHEMA }) ?? {};
    raw = ConfigSchema.parse(parsed);
  } catch (err) {
    if (err.code !== "ENOENT") throw err;
  }
  return normalizeMcpServers(raw.mcp_servers ?? [], process.env);
}
function mergeDefaults(raw, env = process.env) {
  const d = raw.defaults ?? {};
  const wip = raw.wip_limits ?? {};
  const reflect = raw.reflect ?? {};
  const wc = raw.win_cycles ?? {};
  return {
    waiting_for_grace_days: d.waiting_for_grace_days ?? CONFIG_DEFAULTS.waiting_for_grace_days,
    dormant_days: d.dormant_days ?? CONFIG_DEFAULTS.dormant_days,
    max_active_projects: wip.max_active_projects ?? CONFIG_DEFAULTS.max_active_projects,
    someday_review: d.someday_review ?? CONFIG_DEFAULTS.someday_review,
    reflect_day: reflect.day ?? CONFIG_DEFAULTS.reflect_day,
    reflect_duration_minutes: reflect.duration_minutes ?? CONFIG_DEFAULTS.reflect_duration_minutes,
    incoming_queue_threshold: d.incoming_queue_threshold ?? CONFIG_DEFAULTS.incoming_queue_threshold,
    incoming_queue_cache_ttl_minutes: d.incoming_queue_cache_ttl_minutes ?? CONFIG_DEFAULTS.incoming_queue_cache_ttl_minutes,
    inbox_seed_stale_days: d.inbox_seed_stale_days ?? CONFIG_DEFAULTS.inbox_seed_stale_days,
    inbox_seed_softcap: d.inbox_seed_softcap ?? CONFIG_DEFAULTS.inbox_seed_softcap,
    mcp_servers: normalizeMcpServers(raw.mcp_servers ?? [], env),
    win_cycle_current: wc.current,
    win_cycle_start: wc.start,
    win_cycle_end: wc.end,
    win_cycle_mid_check: wc.mid_check
  };
}
function normalizeMcpServers(raw, env) {
  if (!raw || raw.length === 0) return [];
  const seen = /* @__PURE__ */ new Set();
  return raw.map((s) => {
    if (seen.has(s.name)) {
      throw new Error(`duplicate MCP server name in cadence.yaml: ${s.name}`);
    }
    seen.add(s.name);
    if (s.transport === "stdio") {
      return {
        kind: "stdio",
        name: s.name,
        command: expandEnv(s.command, env, s.name),
        args: s.args.map((a) => expandEnv(a, env, s.name)),
        env: Object.fromEntries(
          Object.entries(s.env).map(([k, v]) => [k, expandEnv(v, env, s.name)])
        ),
        ...s.cwd ? { cwd: expandHome(expandEnv(s.cwd, env, s.name)) } : {},
        timeoutMs: s.timeout_ms ?? MCP_DEFAULT_TIMEOUT_MS
      };
    }
    return {
      kind: "http",
      name: s.name,
      url: expandEnv(s.url, env, s.name),
      headers: Object.fromEntries(
        Object.entries(s.headers).map(([k, v]) => [k, expandEnv(v, env, s.name)])
      ),
      timeoutMs: s.timeout_ms ?? MCP_DEFAULT_TIMEOUT_MS
    };
  });
}
var ENV_REF = /\$\{env:([A-Za-z_][A-Za-z0-9_]*)\}/g;
function expandEnv(value, env, serverName) {
  return value.replace(ENV_REF, (_, name) => {
    const v = env[name];
    if (v === void 0) {
      throw new Error(
        `MCP server '${serverName}' references missing env var ${name}`
      );
    }
    return v;
  });
}
function expandHome(value) {
  if (value === "~") return process.env["HOME"] ?? value;
  if (value.startsWith("~/")) {
    const home = process.env["HOME"];
    return home ? path2.join(home, value.slice(2)) : value;
  }
  return value;
}

