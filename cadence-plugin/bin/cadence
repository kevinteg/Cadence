async function resolveRepoRoot(explicit) {
  if (explicit) return path22.resolve(explicit);
  return findRepoRoot(process.cwd());
}
function findRepoRoot(start) {
  let dir = path22.resolve(start);
  for (; ; ) {
    if (existsSync15(path22.join(dir, "cadence.yaml"))) return dir;
    if (existsSync15(path22.join(dir, "pursuits"))) return dir;
    const parent = path22.dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  return path22.resolve(start);
}
function isCadenceRepo(root) {
  return existsSync15(path22.join(root, "cadence.yaml")) || existsSync15(path22.join(root, "pursuits"));
}
function multistring(v) {
  if (!Array.isArray(v)) return void 0;
  const cleaned = v.filter(
    (x) => typeof x === "string" && x !== "undefined" && x.length > 0
  );
  return cleaned.length > 0 ? cleaned : void 0;
}
function parseOriginIssue(raw) {
  if (!raw) return void 0;
  const match = raw.match(/^([^/\s#]+\/[^/\s#]+)#(\d+)$/);
  if (!match) {
    throw new Error(
      `--origin-issue must be "owner/repo#number" (e.g. kevinteg/Cadence#42), got: ${raw}`
    );
  }
  const repo = match[1];
  const number4 = Number(match[2]);
  return {
    kind: "github_issue",
    repo,
    number: number4,
    url: `https://github.com/${repo}/issues/${number4}`
  };
}
function firstLine3(text) {
  const line = text.split("\n")[0]?.trim() ?? "";
  return line.length > 200 ? line.slice(0, 197) + "..." : line;
}
function formatError3(err) {
  if (err instanceof Error) {
    return `cadence: ${err.message}`;
  }
  return `cadence: ${String(err)}`;
}
async function composeInboundFlag(repoRoot, snapshot) {
  let pluginInfo;
  try {
    pluginInfo = await readPluginInfo();
  } catch {
    return null;
  }
  if (!pluginInfo.owner_repo) return null;
  const ttl = snapshot.config.incoming_queue_cache_ttl_minutes;
  const threshold = snapshot.config.incoming_queue_threshold;
  const result = await getInboundCount(repoRoot, pluginInfo.owner_repo, ttl);
  if (result === null) return null;
  if (result.count <= threshold) return null;
  return {
    kind: "inbound_issues_piling_up",
    count: result.count,
    threshold,
    ownerRepo: pluginInfo.owner_repo,
    fromCache: result.fromCache
  };
}
async function readPluginInfo() {
  const pluginDir = findPluginDir();
  if (!pluginDir) {
    throw new Error(
      "Could not locate plugin directory \u2014 no .claude-plugin/plugin.json found above the cadence binary."
    );
  }
  const manifestPath = path22.join(pluginDir, ".claude-plugin", "plugin.json");
  const raw = await readFile11(manifestPath, "utf-8");
  const manifest = JSON.parse(raw);
  const repository = manifest.repository ?? manifest.homepage ?? null;
  return {
    plugin_dir: pluginDir,
    version: manifest.version ?? null,
    repository,
    owner_repo: parseOwnerRepo(repository)
  };
}
function findPluginDir() {
  const scriptPath = fileURLToPath2(import.meta.url);
  let dir = path22.dirname(scriptPath);
  for (let i = 0; i < 6; i++) {
    if (existsSync15(path22.join(dir, ".claude-plugin", "plugin.json"))) {
      return dir;
    }
    const nested = path22.join(dir, "cadence-plugin", ".claude-plugin", "plugin.json");
    if (existsSync15(nested)) {
      return path22.join(dir, "cadence-plugin");
    }
    const parent = path22.dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  return null;
}
function parseOwnerRepo(url2) {
  if (!url2) return null;
  const https = url2.match(
    /^https?:\/\/github\.com\/([^/]+)\/([^/.]+?)(?:\.git)?\/?$/
  );
  if (https) return `${https[1]}/${https[2]}`;
  const ssh = url2.match(/^git@github\.com:([^/]+)\/([^/.]+?)(?:\.git)?$/);
  if (ssh) return `${ssh[1]}/${ssh[2]}`;
  return null;
}
